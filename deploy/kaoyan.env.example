# 复制到 /etc/kaoyan/kaoyan.env 后再填写；不要把真实密钥提交到 Git。
KAOYAN_ADMIN_USER=content-admin
KAOYAN_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
KAOYAN_ADMIN_TOKEN=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_TOKEN
KAOYAN_COOKIE_SECURE=1
KAOYAN_SQLITE_PATH=/var/lib/kaoyan/admission.db
KAOYAN_UPLOAD_DIR=/var/lib/kaoyan/uploads/content
KAOYAN_RAW_DIR=/var/lib/kaoyan/raw

# 推荐的单机部署：录取查询与内容后台都使用 SQLite。
KAOYAN_DB_TYPE=sqlite

# 仅在把录取查询数据切到 MySQL 时取消注释。内容后台仍使用 SQLite。
# KAOYAN_DB_HOST=127.0.0.1
# KAOYAN_DB_PORT=3306
# KAOYAN_DB_USER=kaoyan
# KAOYAN_DB_PASSWORD=CHANGE_ME
# KAOYAN_DB_NAME=kaoyan_admission
# KAOYAN_DB_CHARSET=utf8mb4
