server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;

    root /opt/kaoyan-site;
    index index.html;
    charset utf-8;
    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
    }

    location ^~ /uploads/content/ {
        alias /var/lib/kaoyan/uploads/content/;
        autoindex off;
        expires 7d;
        add_header X-Content-Type-Options nosniff always;
    }

    # 后台页面本身可以访问，但数据库、配置、原始导入文件和源码不能被下载。
    location = /数据库/admission.db { deny all; }
    location = /数据库/config.json { deny all; }
    location ^~ /数据库/raw/ { deny all; }
    location ^~ /.git/ { deny all; }
    location ~* \.(?:py|pyc|pyo|sql|db|sqlite|env)$ { deny all; }

    location / {
        try_files $uri $uri/ =404;
    }
}
